DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# 可选：DeepSeek 模型名，默认 deepseek-flash（官方正式名）
# DEEPSEEK_MODEL=deepseek-flash
# 阿里云 DashScope，用于 Qwen 多模态模型识别扫描件 PDF
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
# 可选：付费备用 key。主 key（免费额度）被拒（HTTP 401/403，额度用完即 403）时自动改用，
# 之后本次运行一直用备用 key；限流（429）不切换。不填则只用主 key
# DASHSCOPE_API_KEY_BACKUP=sk-xxxxxxxxxxxxxxxx
# 可选：OCR 模型，默认 qwen3.8-flash；也可填 qwen3.8-max（更贵）或专用 OCR 模型 qwen-vl-ocr
# QWEN_OCR_MODEL=qwen3.8-flash
# 可选：DeepSeek 不可用（超时 / 连不上 / 5xx / 限流 / 余额不足）时改用的备用模型，用上面的 DashScope key。
# 默认 qwen3.8-flash；设为空（LLM_FALLBACK_MODEL=）关闭，DeepSeek 出错就直接报错
# LLM_FALLBACK_MODEL=qwen3.8-flash
# 企业信息联网查询（企查查/天眼查/公示系统）——预留，暂未接入。
# 不配置时 agent 走 HITL：暂停让律师自行查询后键入法人全称。
# COMPANY_LOOKUP_API_KEY=
# 管理员口令：只有输入此口令才能在「原告信息表」页面上传 / 回退表格（查看、下载不限）。
# 不设置则任何人都不能更新。请设成只有管理员知道的长口令。
# ADMIN_TOKEN=

# 运行日志（JSONL，仅记字段 key/耗时/token，不含案件内容）；设为 0 关闭
RUN_LOG_ENABLED=1
# 运行日志按天切分，旧日志保留天数（日志不含案件内容，故比案件数据保留得久）
RUN_LOG_RETENTION_DAYS=90

# 成本估算单价（元，仅汇总脚本 scripts/cost_report.py 用）：按控制台价格页填写，改价时同时更新日期。
# 下面的数字只是格式示例，不是真实价格
# COST_PRICES={"deepseek-flash": {"input": 1.0, "output": 2.0}, "qwen3.8-flash": {"input": 0.5, "output": 1.0}, "ocr_page": 0.01}
# COST_PRICES_DATE=2026-10-25

# 案件数据（agent checkpoint + 上传的扫描件）保留天数，超期自动清除
CASE_RETENTION_DAYS=7

# 登录：Docker 部署时由 docker-compose.yml 强制开启（AUTH_ENABLED=1），这里不用填。
# 本地开发默认关闭；想在本地试登录页，取消下一行注释，再用 scripts/manage_users.py add 建账号。
# AUTH_ENABLED=1
# 就绪检查：数据目录所在磁盘剩余空间低于此值（MB）时 /readyz 报未就绪，部署会回滚
# READY_MIN_FREE_MB=500
# 每日运行小结（每天 8 点后写 data/daily_summary/前一天.md）；设为 0 关闭。阈值见 config.py「每日运行小结」
# DAILY_SUMMARY_ENABLED=1
# ALERT_MAX_NODE_ERRORS=3
# ALERT_MAX_OCR_FAIL_RATE=0.1
# ALERT_MAX_LLM_FALLBACKS=3
# ALERT_MAX_DAILY_COST=0
